 221:Core/Src/main.c **** 
 222:Core/Src/main.c **** uint16_t calcFSignal(uint32_t selected_sample_size, uint32_t original_file_size){
 223:Core/Src/main.c **** 
 224:Core/Src/main.c **** 	if(selected_sample_size > original_file_size) return 0;
 225:Core/Src/main.c **** 
 226:Core/Src/main.c **** 	static const uint16_t sampling_freq = 44100;
 227:Core/Src/main.c **** 
 228:Core/Src/main.c **** 	return ((float)selected_sample_size / (float)original_file_size) * sampling_freq;
 229:Core/Src/main.c **** }
