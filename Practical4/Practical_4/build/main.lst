 212:Core/Src/main.c **** 
 213:Core/Src/main.c **** uint16_t calcFSignal(uint32_t selected_sample_size, uint32_t original_file_size){
 214:Core/Src/main.c **** 
 215:Core/Src/main.c **** 	if(selected_sample_size > original_file_size) return 0;
 216:Core/Src/main.c **** 
 217:Core/Src/main.c **** 	static const uint16_t sampling_freq = 44100;
 218:Core/Src/main.c **** 
 219:Core/Src/main.c **** 	return ((float)selected_sample_size / (float)original_file_size) * sampling_freq;
 220:Core/Src/main.c **** }
