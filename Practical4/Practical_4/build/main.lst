 164:Core/Src/main.c **** 
 165:Core/Src/main.c **** uint16_t calcFSignal(uint32_t selected_sample_size, uint32_t original_file_size){
 166:Core/Src/main.c **** 
 167:Core/Src/main.c **** 	if(selected_sample_size > original_file_size) return 0;
 168:Core/Src/main.c **** 
 169:Core/Src/main.c **** 	static const uint16_t sampling_freq = 44100;
 170:Core/Src/main.c **** 
 171:Core/Src/main.c **** 	return ((float)selected_sample_size / (float)original_file_size) * sampling_freq;
 172:Core/Src/main.c **** }
