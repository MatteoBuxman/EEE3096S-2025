 397:Core/Src/main.c **** // Run a single test and store results
 398:Core/Src/main.c **** void run_single_test(int image_size, int max_iter, int task_num,
 399:Core/Src/main.c ****                     int data_type, int scaling_factor, int opt_level) {
 400:Core/Src/main.c ****     test_in_progress = 1;
 401:Core/Src/main.c ****     current_image_size = image_size;
 402:Core/Src/main.c ****     current_max_iter = max_iter;
 403:Core/Src/main.c ****     current_data_type = data_type;
 404:Core/Src/main.c ****     current_scaling_factor = scaling_factor;
 405:Core/Src/main.c ****     current_optimization_level = opt_level;
 406:Core/Src/main.c **** 
 407:Core/Src/main.c ****     // Record start time and cycles
 408:Core/Src/main.c ****     start_time = HAL_GetTick();
 409:Core/Src/main.c ****     start_cycles = get_cycle_count();
 410:Core/Src/main.c **** 
 411:Core/Src/main.c ****     // Calculate Mandelbrot based on data type
 412:Core/Src/main.c ****     uint64_t local_checksum = 0;
 413:Core/Src/main.c ****     switch(data_type) {
 414:Core/Src/main.c ****         case 0: // fixed point
 415:Core/Src/main.c ****             local_checksum = calculate_mandelbrot_fixed_point(image_size, image_size, max_iter, sca
 416:Core/Src/main.c ****             break;
 417:Core/Src/main.c ****         case 1: // float
 418:Core/Src/main.c ****             local_checksum = calculate_mandelbrot_float(image_size, image_size, max_iter);
 419:Core/Src/main.c ****             break;
 420:Core/Src/main.c ****         case 2: // double
 421:Core/Src/main.c ****             local_checksum = calculate_mandelbrot_double(image_size, image_size, max_iter);
 422:Core/Src/main.c ****             break;
 423:Core/Src/main.c ****     }
 424:Core/Src/main.c **** 
 425:Core/Src/main.c ****     // Record end time and cycles
 426:Core/Src/main.c ****     end_cycles = get_cycle_count();
 427:Core/Src/main.c ****     end_time = HAL_GetTick();
 428:Core/Src/main.c **** 
ARM GAS  /var/folders/x0/qrp3r5317y18246dwl6ly7b40000gn/T//ccuP9C8c.s 			page 12


 429:Core/Src/main.c ****     execution_time = end_time - start_time;
 430:Core/Src/main.c ****     cycle_count = end_cycles - start_cycles;
 431:Core/Src/main.c **** 
 432:Core/Src/main.c ****     // Calculate throughput
 433:Core/Src/main.c ****     if (execution_time > 0) {
 434:Core/Src/main.c ****         current_throughput = (image_size * image_size) / (execution_time / 1000.0f);
 435:Core/Src/main.c ****     } else {
 436:Core/Src/main.c ****         current_throughput = 0;
 437:Core/Src/main.c ****     }
 438:Core/Src/main.c **** 
 439:Core/Src/main.c ****     // Update Live Expressions variables
 440:Core/Src/main.c ****     current_execution_time = execution_time;
 441:Core/Src/main.c ****     current_cycle_count = cycle_count;
 442:Core/Src/main.c ****     current_checksum = local_checksum;
 443:Core/Src/main.c ****     current_throughput = current_throughput;
 444:Core/Src/main.c **** 
 445:Core/Src/main.c ****     // Store the result
 446:Core/Src/main.c ****     store_test_result(task_num, image_size, max_iter, execution_time,
 447:Core/Src/main.c ****                      cycle_count, local_checksum, current_throughput,
 448:Core/Src/main.c ****                      data_type, scaling_factor, opt_level);
 449:Core/Src/main.c **** 
 450:Core/Src/main.c ****     test_in_progress = 0;
 451:Core/Src/main.c ****     toggle_led(0);
 452:Core/Src/main.c **** }
